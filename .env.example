# =====================================================
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  File .env TIDAK BOLEH di-push ke GitHub.
# =====================================================

# Port server lokal
PORT=3000

# Supabase -> Project Settings -> Data API (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# (atau legacy "service_role" key). JANGAN pakai key ini di frontend.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Zona waktu untuk menentukan status "Terlambat"
APP_TIMEZONE=Asia/Jakarta
